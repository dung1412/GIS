# Copy to .env for local use; never commit .env or actual credentials.
# Esri, OpenStreetMap, NASA and public Sentinel layers do not need these keys.
ENVIRONMENT=production
HOST=127.0.0.1
PORT=8000
WEBGIS_REQUIRE_AUTH=1
WEBGIS_ALLOW_REGISTRATION=0
WEBGIS_ENABLE_DEMO_ACCOUNTS=0

# Optional server-side integrations; leave blank when unused.
GCP_PROJECT_ID=
GOOGLE_MAPS_API_KEY=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
PLANET_API_KEY=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
GEMINI_API_KEY=
