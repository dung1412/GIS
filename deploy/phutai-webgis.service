[Unit]
Description=Phu Tai WebGIS API and frontend
After=network.target

[Service]
Type=simple
User=phutai-webgis
Group=phutai-webgis
WorkingDirectory=/opt/phutai-webgis
EnvironmentFile=/etc/phutai-webgis.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PROJ_NETWORK=OFF
Environment=WEBGIS_REQUIRE_AUTH=1
Environment=WEBGIS_ENABLE_DEMO_ACCOUNTS=0
Environment=WEBGIS_ALLOW_REGISTRATION=0
ExecStart=/usr/bin/env WEBGIS_REQUIRE_AUTH=1 WEBGIS_ENABLE_DEMO_ACCOUNTS=0 WEBGIS_ALLOW_REGISTRATION=0 /opt/phutai-webgis/.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/phutai-webgis/data /opt/phutai-webgis/scratch
StateDirectory=phutai-webgis
StateDirectoryMode=0750
CacheDirectory=phutai-webgis
CacheDirectoryMode=0750

[Install]
WantedBy=multi-user.target
